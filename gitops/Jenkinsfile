pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        GITHUB_CREDENTIAL_ID = 'github-credentials'
        GIT_REPO_URL = 'https://github.com/ThanhDu14/DevSecOps-Platform.git'
        GIT_BRANCH = 'feature-build-ci/cd'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker Image Tag to deploy (e.g., v1.0.12)')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                git branch: "${GIT_BRANCH}", credentialsId: "${GITHUB_CREDENTIAL_ID}", url: "${GIT_REPO_URL}"
            }
        }

        stage('2. Manual Approval') {
            when {
                expression { params.IMAGE_TAG != '' }
            }
            steps {
                script {
                    timeout(time: 10, unit: 'MINUTES') {
                        def deployer = input(
                            message: "Deploy image tag ${params.IMAGE_TAG} to Production Kubernetes?",
                            ok: "Approve Deploy",
                            submitterParameter: 'APPROVED_BY'
                        )
                        echo "Deployment approved by: ${deployer}"
                    }
                }
            }
        }

        stage('3. Update K8s Manifests') {
            steps {
                script {
                    if (params.IMAGE_TAG == '') {
                        error "Parameter IMAGE_TAG is required!"
                    }
                    
                    echo "Updating K8s YAML files with new image tag: ${params.IMAGE_TAG}"
                    
                    // Dùng lệnh sed để thay thế version của image
                    sh """
                        sed -i "s|image: thanhdu.jfrog.io/docker-local/frontend:.*|image: thanhdu.jfrog.io/docker-local/frontend:${params.IMAGE_TAG}|g" k8s/frontend.yaml
                        sed -i "s|image: thanhdu.jfrog.io/docker-local/backend:.*|image: thanhdu.jfrog.io/docker-local/backend:${params.IMAGE_TAG}|g" k8s/backend.yaml
                        
                        grep -q "frontend:${params.IMAGE_TAG}" k8s/frontend.yaml || { echo "Frontend tag update failed!"; exit 1; }
                        grep -q "backend:${params.IMAGE_TAG}" k8s/backend.yaml || { echo "Backend tag update failed!"; exit 1; }
                    """
                }
            }
        }

        stage('4. Push to GitHub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${GITHUB_CREDENTIAL_ID}", passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        sh """
                            git config user.email "jenkins-gitops@devsecops.local"
                            git config user.name "Jenkins GitOps Bot"
                            
                            git add k8s/frontend.yaml k8s/backend.yaml
                            
                            # Kiểm tra xem có sự thay đổi nào không, nếu có thì commit và push
                            if ! git diff-index --quiet HEAD; then
                                git commit -m "GitOps: Update image tags to ${params.IMAGE_TAG} [skip ci]"
                                git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/ThanhDu14/DevSecOps-Platform.git HEAD:${GIT_BRANCH}
                            else
                                echo "No changes detected. Skipping push."
                            fi
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ GITOPS CD SUCCESSFUL! Changes pushed to GitHub. ArgoCD will sync shortly."
            script {
                try {
                    def authorEmail = sh(script: "git --no-pager show -s --format='%ae'", returnStdout: true).trim()
                    mail to: authorEmail,
                         subject: "✅ CD SUCCESS: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                         body: "GitOps CD deployed ${params.IMAGE_TAG} successfully to K8s configs.\nCheck console output at: ${env.BUILD_URL}"
                } catch (Exception e) {
                    echo "Could not fetch git author email. Skipping success email notification."
                }
            }
        }
        failure {
            echo "❌ GITOPS CD FAILED!"
            script {
                try {
                    def authorEmail = sh(script: "git --no-pager show -s --format='%ae'", returnStdout: true).trim()
                    mail to: authorEmail,
                         subject: "❌ CD FAILED: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                         body: "The GitOps CD pipeline failed.\nCheck console output at: ${env.BUILD_URL}"
                } catch (Exception e) {
                    echo "Could not fetch git author email. Skipping failure email notification."
                }
            }
        }
    }
}
